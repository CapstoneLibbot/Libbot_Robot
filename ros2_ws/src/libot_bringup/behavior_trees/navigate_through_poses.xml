<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateThroughPosesRecovery">
      <PipelineSequence name="NavigateThroughPosesWithReplanning">
        <RateController hz="4.0">
          <RecoveryNode number_of_retries="1" name="ComputePathThroughPoses">
            <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"
                                     error_code_id="{compute_path_error_code}"/>
            <Sequence name="WaitBeforePlannerRetry">
              <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
              <!-- Preserve the obstacle in the global costmap before replanning. -->
              <Wait wait_duration="0.5"/>
            </Sequence>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"
                      error_code_id="{follow_path_error_code}"/>
          <Sequence name="BackUpAndReplanOnControllerFailure">
            <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
            <BackUp backup_dist="0.20" backup_speed="0.10"
                    time_allowance="5.0"/>
            <Wait wait_duration="0.5"/>
            <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"
                                     error_code_id="{compute_path_error_code}"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <Sequence name="RecoveryIfUseful">
        <Fallback name="CanRecover">
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
        </Fallback>
        <ReactiveFallback name="NavigateThroughPosesRecoveryFallback">
          <GoalUpdated/>
          <RoundRobin name="NavigateThroughPosesRecoveryActions">
            <!-- Keep the blind rear recovery short; collision checks stay enabled. -->
            <BackUp backup_dist="0.15" backup_speed="0.10"
                    time_allowance="5.0"/>
            <Wait wait_duration="2.0"/>
          </RoundRobin>
        </ReactiveFallback>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
