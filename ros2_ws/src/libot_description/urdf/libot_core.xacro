<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertia ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
             iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
             izz="${mass * (x*x + y*y) / 12.0}"/>
  </xacro:macro>

  <xacro:macro name="libot_core">
    <material name="libot_blue"><color rgba="0.05 0.55 0.72 1"/></material>
    <material name="libot_dark"><color rgba="0.08 0.11 0.15 1"/></material>
    <material name="lidar_black"><color rgba="0.02 0.02 0.02 1"/></material>

    <link name="base_footprint"/>
    <link name="base_link">
      <visual><origin xyz="0 0 0.16"/><geometry><box size="0.50 0.40 0.30"/></geometry><material name="libot_blue"/></visual>
      <collision><origin xyz="0 0 0.16"/><geometry><box size="0.50 0.40 0.30"/></geometry></collision>
      <inertial><origin xyz="0 0 0.16"/><mass value="18"/><xacro:box_inertia mass="18" x="0.50" y="0.40" z="0.30"/></inertial>
    </link>
    <joint name="base_footprint_to_base_link" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.05"/></joint>

    <xacro:macro name="wheel" params="side sign">
      <link name="${side}_wheel_link">
        <visual><geometry><cylinder radius="0.075" length="0.035"/></geometry><material name="libot_dark"/></visual>
        <collision><geometry><cylinder radius="0.075" length="0.035"/></geometry></collision>
        <inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0014"/></inertial>
      </link>
      <joint name="${side}_wheel_joint" type="continuous"><parent link="base_link"/><child link="${side}_wheel_link"/><origin xyz="0 ${sign * 0.215} 0.075" rpy="1.5708 0 0"/><axis xyz="0 0 1"/></joint>
    </xacro:macro>
    <xacro:wheel side="left" sign="1"/>
    <xacro:wheel side="right" sign="-1"/>

    <link name="caster_link">
      <visual><geometry><sphere radius="0.035"/></geometry><material name="libot_dark"/></visual>
      <collision><geometry><sphere radius="0.035"/></geometry></collision>
      <inertial><mass value="0.1"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    </link>
    <joint name="caster_joint" type="fixed"><parent link="base_link"/><child link="caster_link"/><origin xyz="-0.18 0 0.035"/></joint>

    <!--
      LiDAR mounting measurements:
      - centre: 0.10 m behind the robot centre, with no lateral offset;
      - top surface: 0.27 m above the ground;
      - base_link is 0.05 m above the ground and the LiDAR model is 0.055 m
        tall, therefore the LiDAR centre is 0.1925 m above base_link.
      The LiDAR +X axis remains aligned with the robot front (+X of base_link).
    -->
    <link name="laser">
      <visual><geometry><cylinder radius="0.045" length="0.055"/></geometry><material name="lidar_black"/></visual>
      <collision><geometry><cylinder radius="0.045" length="0.055"/></geometry></collision>
      <inertial><mass value="0.15"/><inertia ixx="0.00015" ixy="0" ixz="0" iyy="0.00015" iyz="0" izz="0.00015"/></inertial>
    </link>
    <joint name="base_link_to_laser" type="fixed"><parent link="base_link"/><child link="laser"/><origin xyz="-0.10 0 0.1925" rpy="0 0 0"/></joint>
  </xacro:macro>
</robot>
