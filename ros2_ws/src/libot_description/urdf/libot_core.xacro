<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertia ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
             iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
             izz="${mass * (x*x + y*y) / 12.0}"/>
  </xacro:macro>

  <xacro:macro name="libot_core">
    <material name="libot_blue"><color rgba="0.05 0.55 0.72 1"/></material>
    <material name="libot_dark"><color rgba="0.08 0.11 0.15 1"/></material>
    <material name="lidar_black"><color rgba="0.02 0.02 0.02 1"/></material>

    <link name="base_footprint"/>
    <link name="base_link">
      <visual><origin xyz="0 0 0.09"/><geometry><box size="0.30 0.30 0.16"/></geometry><material name="libot_blue"/></visual>
      <collision><origin xyz="0 0 0.09"/><geometry><box size="0.30 0.30 0.16"/></geometry></collision>
      <inertial><origin xyz="0 0 0.09"/><mass value="18"/><xacro:box_inertia mass="18" x="0.30" y="0.30" z="0.16"/></inertial>
    </link>
    <joint name="base_footprint_to_base_link" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.05"/></joint>

    <xacro:macro name="mecanum_wheel" params="corner x y">
      <link name="${corner}_wheel_link">
        <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.03" length="0.035"/></geometry><material name="libot_dark"/></visual>
        <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.03" length="0.035"/></geometry></collision>
        <inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0014"/></inertial>
      </link>
      <joint name="${corner}_wheel_joint" type="continuous">
        <parent link="base_link"/><child link="${corner}_wheel_link"/>
        <!-- base_link is 0.05 m above base_footprint; wheel centers sit 0.03 m above it. -->
        <origin xyz="${x} ${y} -0.02" rpy="0 0 0"/>
        <!-- A +Y wheel axis makes positive MecanumDrive speed roll toward +X. -->
        <axis xyz="0 1 0"/>
      </joint>
    </xacro:macro>
    <!-- Geometry matches ROBOT_L=0.135 m and ROBOT_W=0.165 m in Libbot_STM32. -->
    <xacro:mecanum_wheel corner="front_left" x="0.135" y="0.165"/>
    <xacro:mecanum_wheel corner="front_right" x="0.135" y="-0.165"/>
    <xacro:mecanum_wheel corner="rear_left" x="-0.135" y="0.165"/>
    <xacro:mecanum_wheel corner="rear_right" x="-0.135" y="-0.165"/>

    <link name="laser">
      <visual><geometry><cylinder radius="0.045" length="0.055"/></geometry><material name="lidar_black"/></visual>
      <collision><geometry><cylinder radius="0.045" length="0.055"/></geometry></collision>
      <inertial><mass value="0.15"/><inertia ixx="0.00015" ixy="0" ixz="0" iyy="0.00015" iyz="0" izz="0.00015"/></inertial>
    </link>
    <joint name="base_link_to_laser" type="fixed"><parent link="base_link"/><child link="laser"/><origin xyz="-0.10 0 0.20" rpy="0 0 0"/></joint>

    <link name="imu_link"/>
    <joint name="base_link_to_imu" type="fixed">
      <parent link="base_link"/><child link="imu_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Sensor centres at the 0.30 x 0.30 m outer envelope. -->
    <link name="ultrasonic_front_link"/>
    <joint name="base_link_to_ultrasonic_front" type="fixed">
      <parent link="base_link"/><child link="ultrasonic_front_link"/>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
    </joint>

    <link name="ultrasonic_left_link"/>
    <joint name="base_link_to_ultrasonic_left" type="fixed">
      <parent link="base_link"/><child link="ultrasonic_left_link"/>
      <origin xyz="0 0.15 0" rpy="0 0 1.57079632679"/>
    </joint>

    <link name="ultrasonic_right_link"/>
    <joint name="base_link_to_ultrasonic_right" type="fixed">
      <parent link="base_link"/><child link="ultrasonic_right_link"/>
      <origin xyz="0 -0.15 0" rpy="0 0 -1.57079632679"/>
    </joint>

    <link name="ultrasonic_rear_link"/>
    <joint name="base_link_to_ultrasonic_rear" type="fixed">
      <parent link="base_link"/><child link="ultrasonic_rear_link"/>
      <origin xyz="-0.15 0 0" rpy="0 0 3.14159265359"/>
    </joint>
  </xacro:macro>
</robot>
