<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="libbot">

    <link name="base_footprint"/>

    <link name="base_link"/>

    <joint name="base_footprint_to_base_link"
           type="fixed">

        <parent link="base_footprint"/>
        <child link="base_link"/>

        <origin xyz="0 0 0.10"
                rpy="0 0 0"/>

    </joint>


    <link name="laser"/>

    <joint name="base_link_to_laser"
           type="fixed">

        <parent link="base_link"/>
        <child link="laser"/>

        <!-- TEMPORARY -->
        <!-- Sau này đo chính xác vị trí LiDAR -->

        <origin xyz="-0.08 -0.02 0.23"
                rpy="0 0 1.5708"/>

    </joint>

</robot>
