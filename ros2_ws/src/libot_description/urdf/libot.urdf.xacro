<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="libot">

    <xacro:property name="robot_length" value="0.30"/>
    <xacro:property name="robot_width" value="0.24"/>
    <xacro:property name="robot_height" value="0.20"/>

    <link name="base_footprint"/>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${robot_length} ${robot_width} ${robot_height}"/>
            </geometry>
        </visual>
    </link>

    <joint name="base_footprint_to_base_link"
           type="fixed">

        <parent link="base_footprint"/>
        <child link="base_link"/>

        <origin xyz="0 0 0.10"
                rpy="0 0 0"/>

    </joint>

    <link name="laser"/>

    <joint name="laser_joint"
           type="fixed">

        <parent link="base_link"/>
        <child link="laser"/>

        <origin xyz="0 0 0.20"
                rpy="0 0 0"/>

    </joint>

</robot>