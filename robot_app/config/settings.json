{
  "tcp": {
    "host": "0.0.0.0",
    "port": 9000,
    "buffer_size": 4096,
    "timeout": 5
  },
  "runtime": {
    "id": "real",
    "backend_url": "http://127.0.0.1:5205",
    "telemetry_hz": 5
  },
  "robot": {
    "name": "libot_pi",
    "max_speed": 1.0,
    "safe_mode": true
  },
  "hardware": {
    "navigation": {
      "enabled": true,
      "driver": "ros"
    },
    "scanner": {
      "enabled": true,
      "device": "camera",
      "timeout_sec": 5
    },
    "motion_safety": {
      "enabled": true,
      "method": "ros_topic",
      "topic": "/cmd_vel"
    },
    "ui": {
      "enabled": true,
      "screen": "lcd"
    },
    "speaker": {
      "enabled": true,
      "volume": 70
    }
  },
  "workflow": {
    "steps": []
  }
}
