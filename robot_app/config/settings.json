{
  "tcp": {
    "host": "0.0.0.0",
    "port": 9000,
    "buffer_size": 4096,
    "timeout": 5
  },
  "runtime": {
    "id": "real",
    "backend_url": "http://127.0.0.1:5205",
    "telemetry_hz": 5
  },
  "robot": {
    "name": "libot_pi",
    "max_speed": 1.0,
    "safe_mode": true
  },
  "hardware": {
    "navigation": {
      "enabled": true,
      "driver": "ros"
    },
    "inventory_scan": {
      "spacing_m": 0.2,
      "speed_mps": 0.5,
      "min_speed_mps": 0.04,
      "min_angular_speed_radps": 0.08,
      "lateral_tolerance_m": 0.04,
      "heading_tolerance_rad": 0.15,
      "segment_timeout_sec": 20
    },
    "scanner": {
      "enabled": true,
      "device": "imx500-tcp://127.0.0.1:9011",
      "timeout_sec": 5
    },
    "motion_safety": {
      "enabled": true,
      "method": "ros_topic",
      "topic": "/cmd_vel"
    },
    "ui": {
      "enabled": true,
      "screen": "lcd",
      "driver": "tkinter"
    },
    "speaker": {
      "enabled": true,
      "driver": "espeak",
      "volume": 70
    }
  },
  "workflow": {
    "steps": []
  }
}
